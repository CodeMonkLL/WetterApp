# Server- & Umgebungseinstellungen
PORT=5000
FLASK_ENV=development
SECRET_KEY=ein_sehr_geheimer_schluessel_fuer_flask

# Datenbank Zugangsdaten (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=krassesPw
DB_NAME=wetterapp_db
DB_PORT=5432

# Hosts für die Kommunikation zwischen den Docker-Containern
# Innerhalb von Docker heißt der DB-Host so wie der Service in compose ("db")
DB_HOST=db

# Zusammengebauter Connection String für SQLAlchemy
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}